# Bridge the SSH/GPG agent sockets through a socat relay instead of bind-mounting
# them directly. A bind mount pins the socket's inode at container-creation time,
# so it goes stale when the forwarded agent is replaced (e.g. after an SSH
# reconnect). socat's `fork` re-resolves SSH_AUTH_SOCK/GNUPG_SOCK on every new
# connection, so a stable agent path (as ssht keeps it) always reaches the live
# agent without recreating the container.
#
# macOS uses a TCP relay (VirtioFS unix-socket forwarding is unreliable). Linux
# uses a unix-socket relay in a mode-700 mktemp dir bind-mounted into the
# container: reachable only from this container (matching uid), no TCP exposure.
SSH_RELAY_PORT=""
GPG_RELAY_PORT=""
AGENT_RELAY_DIR=""
# Session-scoped pid file: overlapping sessions of the same project must not
# kill each other's relays/forwards on exit.
SOCAT_PIDFILE="/tmp/.vibe-socat-pids-${PROJECT_NAME}-$$"
if command -v socat &>/dev/null; then
  have_ssh_sock() { [[ -n "${SSH_AUTH_SOCK:-}" && -S "$SSH_AUTH_SOCK" ]]; }
  have_gpg_sock() { [[ -n "${GNUPG_SOCK:-}" && -S "$GNUPG_SOCK" ]]; }
  if ((IS_MACOS)); then
    if have_ssh_sock; then
      SSH_RELAY_PORT=$(free_port)
      socat "TCP-LISTEN:${SSH_RELAY_PORT},bind=127.0.0.1,reuseaddr,fork" \
        "UNIX-CONNECT:${SSH_AUTH_SOCK}" 2>/dev/null &
      echo "$! ssh-relay" >> "$SOCAT_PIDFILE"
    fi
    if have_gpg_sock; then
      GPG_RELAY_PORT=$(free_port)
      socat "TCP-LISTEN:${GPG_RELAY_PORT},bind=127.0.0.1,reuseaddr,fork" \
        "UNIX-CONNECT:${GNUPG_SOCK}" 2>/dev/null &
      echo "$! gpg-relay" >> "$SOCAT_PIDFILE"
    fi
  elif have_ssh_sock || have_gpg_sock; then
    AGENT_RELAY_DIR="/tmp/.vibe-agent-${PROJECT_NAME}"
    mkdir -m 700 -p "$AGENT_RELAY_DIR"
    # A live relay from an overlapping session already serves the socket; a stale
    # one (its socat died) leaves a file that UNIX-LISTEN would refuse to bind.
    relay_needed() {
      [[ -S "$1" ]] || return 0
      socat -u /dev/null "UNIX-CONNECT:$1" &>/dev/null && return 1
      rm -f "$1"
    }
    if have_ssh_sock && relay_needed "${AGENT_RELAY_DIR}/ssh.sock"; then
      socat "UNIX-LISTEN:${AGENT_RELAY_DIR}/ssh.sock,fork,mode=666" \
        "UNIX-CONNECT:${SSH_AUTH_SOCK}" 2>/dev/null &
      echo "$! ssh-relay" >> "$SOCAT_PIDFILE"
    fi
    if have_gpg_sock && relay_needed "${AGENT_RELAY_DIR}/gpg.sock"; then
      socat "UNIX-LISTEN:${AGENT_RELAY_DIR}/gpg.sock,fork,mode=666" \
        "UNIX-CONNECT:${GNUPG_SOCK}" 2>/dev/null &
      echo "$! gpg-relay" >> "$SOCAT_PIDFILE"
    fi
  fi
fi

