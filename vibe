        [[ -f "$MARKER" ]] && continue
        touch "$MARKER"
        socat "TCP-LISTEN:${PORT},reuseaddr,fork" "EXEC:docker exec -i ${CID} socat STDIO TCP\:127.0.0.1\:${PORT}" 2>/dev/null &
        echo "$! $PORT" >> "$SOCAT_PIDFILE"
      done
    done
  ) &
  PORT_WATCHER_PID=$!
  disown
elif [[ ! -f "$HOME/.claude-docker/.no-socat-warning" ]]; then
  echo "Warning: 'socat' is not installed. OAuth login callback won't work." >&2
  if ! ((QUERY)); then
    echo "Install it with your package manager (e.g. sudo pacman -S socat)." >&2
    read -rp "Continue? [Y/n/never] " ans
    case "$(tolower "$ans")" in
      n|no) exit 1 ;;
      never) mkdir -p "$HOME/.claude-docker" && touch "$HOME/.claude-docker/.no-socat-warning" ;;
    esac
  fi
fi

PBPASTE_IMG_CACHE=""

# Read host clipboard content
read_host_clipboard() {
  local req="$1" outfile="$2"
  if [[ "$req" == "LIST" ]]; then
    if [[ "$CLIP_CMD" == "pbpaste" ]]; then
      local info types=""
      PBPASTE_IMG_CACHE=""
      info=$(osascript -e 'clipboard info' 2>/dev/null) || info=""
      if [[ "$info" == *"«class PNGf»"* ]] || [[ "$info" == *"«class TIFF»"* ]]; then
        types="image/png"
        PBPASTE_IMG_CACHE="$(mktemp)"
        osascript -l JavaScript -e '
          ObjC.import("AppKit");
          ObjC.import("Foundation");
          var pb = $.NSPasteboard.generalPasteboard;
          var data = pb.dataForType("public.png");
          if (!data || data.isNil()) {
            var tiffData = pb.dataForType("public.tiff");
            if (tiffData && !tiffData.isNil()) {
              var rep = $.NSBitmapImageRep.imageRepWithData(tiffData);
              if (rep && !rep.isNil()) {
                data = rep.representationUsingTypeProperties(4, $.NSDictionary.dictionary);
              }
            }
          }
          if (data && !data.isNil()) {
            data.writeToFileAtomically("'"$PBPASTE_IMG_CACHE"'", true);
          }
        ' &>/dev/null
        [[ -s "$PBPASTE_IMG_CACHE" ]] || { rm -f "$PBPASTE_IMG_CACHE"; PBPASTE_IMG_CACHE=""; types=""; }
      fi
      if [[ "$info" == *"«class utf8»"* ]]; then
        types="${types:+$types
}text/plain"
      fi
      echo "${types:-text/plain}" > "${outfile}.tmp"
    elif [[ "$CLIP_CMD" == "wl-paste" ]]; then
      wl-paste -l 2>/dev/null > "${outfile}.tmp" || echo -n > "${outfile}.tmp"
    else
      xclip -selection clipboard -t TARGETS -o 2>/dev/null > "${outfile}.tmp" || echo -n > "${outfile}.tmp"
    fi
  else
    if [[ "$CLIP_CMD" == "pbpaste" ]]; then
      if [[ "$req" == "image/png" ]] && [[ -n "$PBPASTE_IMG_CACHE" ]] && [[ -s "$PBPASTE_IMG_CACHE" ]]; then
        cp "$PBPASTE_IMG_CACHE" "${outfile}.tmp"
        rm -f "$PBPASTE_IMG_CACHE"
        PBPASTE_IMG_CACHE=""
      elif [[ "$req" == "image/png" ]]; then
        echo -n > "${outfile}.tmp"
      else
        pbpaste 2>/dev/null > "${outfile}.tmp" || echo -n > "${outfile}.tmp"
      fi
    elif [[ "$CLIP_CMD" == "wl-paste" ]]; then
      wl-paste --type "$req" 2>/dev/null > "${outfile}.tmp" || echo -n > "${outfile}.tmp"
    else
      xclip -selection clipboard -t "$req" -o 2>/dev/null > "${outfile}.tmp" || echo -n > "${outfile}.tmp"
    fi
  fi
  mv "${outfile}.tmp" "$outfile"
}

# Start background watchers
BROWSER_WATCHER_PID=""
CLIPBOARD_WATCHER_PID=""

if ((IS_MACOS)); then
  # macOS: poll container queue dirs via docker exec
  CID="$CONTAINER_NAME"

  if [[ -n "$OPEN_CMD" ]]; then
    (
      while true; do
        sleep 0.5
        files="$(docker exec "$CID" ls /tmp/browser_queue/ 2>/dev/null)" || continue
        for f in $files; do
          url="$(docker exec "$CID" cat "/tmp/browser_queue/$f" 2>/dev/null)" || continue
          docker exec "$CID" rm -f "/tmp/browser_queue/$f" 2>/dev/null
          [[ -n "$url" ]] && $OPEN_CMD "$url" &>/dev/null &
        done
      done
    ) &
    BROWSER_WATCHER_PID=$!
    disown
  fi

  if [[ -n "$CLIP_CMD" ]]; then
    (
      while true; do
        sleep 0.5
        files="$(docker exec "$CID" ls /tmp/clipboard_queue/ 2>/dev/null)" || continue
        for f in $files; do
          req="$(docker exec "$CID" cat "/tmp/clipboard_queue/$f" 2>/dev/null)" || continue
          docker exec "$CID" rm -f "/tmp/clipboard_queue/$f" 2>/dev/null
          [[ -n "$req" ]] || continue
          tmpfile="$(mktemp)"
          read_host_clipboard "$req" "$tmpfile"
          # Write via tmp+mv so the polling wrapper never reads a partial file
          docker exec -i "$CID" sh -c \
            "cat > '/tmp/clipboard_resp/$f.tmp' && mv '/tmp/clipboard_resp/$f.tmp' '/tmp/clipboard_resp/$f'" \
            < "$tmpfile"
          rm -f "$tmpfile"
        done
      done
    ) &
    CLIPBOARD_WATCHER_PID=$!
    disown
  fi

else
  # Linux: read from FIFOs directly

  if [[ -n "$OPEN_CMD" ]]; then
    (
      while [[ -p "$BROWSER_FIFO" ]]; do
        if read -r url < "$BROWSER_FIFO" 2>/dev/null; then
          $OPEN_CMD "$url" &>/dev/null &
        fi
      done
    ) &
    BROWSER_WATCHER_PID=$!
    disown
  fi

  if [[ -n "$CLIP_CMD" ]]; then
    (
      while [[ -p "$CLIPBOARD_FIFO" ]]; do
        if line=$(cat "$CLIPBOARD_FIFO" 2>/dev/null) && [[ -n "$line" ]]; then
          id="${line%% *}"
          req="${line#* }"
          read_host_clipboard "$req" "${CLIPBOARD_RESP_DIR}/${id}"
        fi
      done
    ) &
    CLIPBOARD_WATCHER_PID=$!
    disown
  fi
fi

# Clean up watcher on exit
cleanup() {
  if ((QUERY)); then
    :
  elif [[ -n "$TMUX_WINDOW" ]]; then
    # A closed window must not abort cleanup: set -e stays active inside traps.
    tmux set-option -w -t "$TMUX_WINDOW" automatic-rename on 2>/dev/null || true
  else
    printf '\033]0;\007'
  fi
  if [[ -n "$BROWSER_WATCHER_PID" ]]; then
    kill "$BROWSER_WATCHER_PID" 2>/dev/null || true
  fi
  if [[ -n "$CLIPBOARD_WATCHER_PID" ]]; then
    kill "$CLIPBOARD_WATCHER_PID" 2>/dev/null || true
  fi
  if [[ -n "$PORT_WATCHER_PID" ]]; then
    kill "$PORT_WATCHER_PID" 2>/dev/null || true
  fi
  # Kill only this session's relays/forwards; a newer session for the same
  # project may still be running its own.
  if [[ -f "$SOCAT_PIDFILE" ]]; then
    while read -r pid port; do
      kill "$pid" 2>/dev/null || true
      if [[ "$port" =~ ^[0-9]+$ ]]; then
        rm -f "/tmp/.vibe-socat-${PROJECT_NAME}-${port}"
      fi
    done < "$SOCAT_PIDFILE"
    rm -f "$SOCAT_PIDFILE"
  fi
  # The relay dir and FIFOs are mount sources, so they stay as long as the
  # container does: docker recreates a deleted one as root, undeletable.
  if ((REMOVE_ON_EXIT)) && ! ((TORN_DOWN)); then
    teardown_container
  fi
}
trap cleanup EXIT

# Set up exec command (WORKDIR computed above, shared with the container env).
# Query mode drops -it so no TTY bytes leak into piped stdout and claude -p
# doesn't sit waiting on an open stdin.
if ((QUERY)); then
  EXEC=(docker exec "${ENVS[@]}" -w "$WORKDIR" "$CONTAINER_NAME")
else
  EXEC=(docker exec -it "${ENVS[@]}" -w "$WORKDIR" "$CONTAINER_NAME")
fi

# Shell into the container if in debug mode
if ((DEBUG)); then
  "${EXEC[@]}" /entrypoint.sh bash
  exit 0
fi

# Query one-off: run the prompt non-interactively and print the result to stdout.
if ((QUERY)); then
  "${EXEC[@]}" /entrypoint.sh claude -p "$QUERY_PROMPT" --dangerously-skip-permissions < /dev/null
  exit 0
fi

# Run Claude Code in the container
SYSTEM_PROMPT=""

if [[ -n "$WORKTREE" ]]; then
  read -r -d '' _PROMPT <<EOF || true
You are working inside a git worktree for branch '$WORKTREE_BRANCH' at $WORKDIR.
The parent repository is mounted read-only — only this worktree directory and .git/ are writable.
You may read parent files (e.g. to compare against main), but do not attempt to modify them.
EOF
  SYSTEM_PROMPT+="${_PROMPT}"$'\n\n'
fi

# .claude/ is shared across worktrees, so the branch-scoped path can only be
# resolved per-container — baking it into CLAUDE.md would race between sessions.
# The default branch owns the global BACKLOG/PROGRESS at .claude/ root; other
# branches get their own subdirectory and read/update access to the global ones.
VIBE_BRANCH="${WORKTREE_BRANCH:-$(git -C "$WORKDIR" branch --show-current 2>/dev/null || true)}"
DEFAULT_BRANCH="$(git -C "$WORKDIR" symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null || true)"
DEFAULT_BRANCH="${DEFAULT_BRANCH#origin/}"
if [[ -z "$DEFAULT_BRANCH" ]]; then
  for _branch in main master dev; do
    if git -C "$WORKDIR" show-ref --verify --quiet "refs/heads/$_branch" 2>/dev/null; then
      DEFAULT_BRANCH="$_branch"
      break
    fi
  done
fi
if [[ -n "$VIBE_BRANCH" && "$VIBE_BRANCH" == "$DEFAULT_BRANCH" ]]; then
  SYSTEM_PROMPT+="You are on the default branch '${VIBE_BRANCH}'. BACKLOG.md and PROGRESS.md live at .claude/ root — they are the project-wide files for global tasks. Keep plans for a specific task or epic in that task's branch directory under .claude/branches/, not here. .claude/ is shared across all worktrees. MEMORY.md and .claude/memory/ remain shared."$'\n\n'
else
  VIBE_BRANCH_SLUG="${VIBE_BRANCH:-detached}"
  VIBE_BRANCH_SLUG="${VIBE_BRANCH_SLUG//\//-}"
  SYSTEM_PROMPT+="BACKLOG.md and PROGRESS.md for this branch live in .claude/branches/${VIBE_BRANCH_SLUG}/ — read and write them there, and create the directory if it does not exist. The BACKLOG.md and PROGRESS.md at .claude/ root are project-wide and owned by the default branch: read them for global context and update a global task's status when your work changes it, but keep this branch's own plans and progress in your subdirectory. .claude/ is shared across all worktrees. MEMORY.md and .claude/memory/ remain shared."$'\n\n'
fi

SYSTEM_PROMPT+="Memory is shared across concurrent sessions: agents in other worktrees or parallel sessions may write memory files and MEMORY.md at the same time as you. After saving or editing a memory, re-read the file to verify your change landed intact — re-apply it if a concurrent write clobbered it — before moving on to the next step."$'\n\n'

if [[ -n "$PARENT_DIR" ]]; then
  SYSTEM_PROMPT+="Sibling repos available read-only at /repos/. Working project: $(realpath --relative-to="$PARENT_DIR" "$TARGET_DIR")."$'\n'
fi

TOOL_FLAGS=(--permission-mode "$PERMISSION_MODE" --allow-dangerously-skip-permissions)
if [[ -n "$SYSTEM_PROMPT" ]]; then
  TOOL_FLAGS+=(--append-system-prompt "$SYSTEM_PROMPT")
fi


if [[ ${#EXTRA_ARGS[@]} -gt 0 ]]; then
  "${EXEC[@]}" /entrypoint.sh claude "${TOOL_FLAGS[@]}" "${EXTRA_ARGS[@]}"
else
  "${EXEC[@]}" /entrypoint.sh claude --continue "${TOOL_FLAGS[@]}" \
    || "${EXEC[@]}" /entrypoint.sh claude "${TOOL_FLAGS[@]}"
fi

clear

# Prompt to remove worktree if one was created. Dropping the worktree makes its
# container useless, and the container must go first anyway to release the mount.
if [[ -n "$WORKTREE" ]]; then
  read -rp "Remove worktree '$WORKTREE_BRANCH'? [y/N] " answer
  if [[ "$answer" == [yY] ]]; then
    teardown_container
    git worktree remove "$WORKTREE" 2>/dev/null || rm -rf "$WORKTREE"
    echo "Worktree '$WORKTREE_BRANCH' removed."
  fi
fi
